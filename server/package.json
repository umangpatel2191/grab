{
  "name": "grab-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GRAB backend: safe website/social media discovery for the GRAB Figma plugin",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "cheerio": "^1.0.0",
    "fastify": "^5.0.0",
    "ipaddr.js": "^2.2.0",
    "undici": "^7.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.48.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
