{
  "name": "grab-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GRAB Figma plugin: find website images and video, preview, download or insert",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run build:ui && npm run build:code",
    "build:ui": "vite build",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --minify",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.code.json",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
